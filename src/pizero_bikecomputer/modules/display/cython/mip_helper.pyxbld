import os

def make_ext(modname, pyxfilename):
    from distutils.extension import Extension
    import numpy
    cython_dir = os.path.dirname(pyxfilename)
    ext = Extension(name = modname,
        sources=[pyxfilename, os.path.join(cython_dir, 'mip_display.cpp')],
        extra_compile_args=['-std=c++17'],
        language='c++',
        include_dirs = [cython_dir, numpy.get_include()],
        extra_link_args = ['-lpigpiod_if2'],
    )
    return ext

#for print
def make_setup_args():
    return dict(script_args=['--verbose'])
